<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- M0-02: isolated mobile worker runtime. Build: mvn -f mobile-runner/pom.xml
         Appium + Selenium 4.43.0 live HERE only. Portal/web Selenium stays 4.49.0.
         Not listed in keel-parent modules. Portal must never depend on this artifact. -->
    <groupId>org.example</groupId>
    <artifactId>mobile-runner</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>mobile-runner</name>

    <properties>
        <!-- Standalone module (no keel-parent): skip CLI exec/spring-boot so reactor exec:java only runs in keel-portal. -->
        <exec.skip>true</exec.skip>
        <spring-boot.run.skip>true</spring-boot.run.skip>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Proposed pin (M0-02); live qualify is QA-owned — see mobile-toolchain.lock.json -->
        <appium.java.client.version>10.1.1</appium.java.client.version>
        <selenium.mobile.version>4.43.0</selenium.mobile.version>
        <testng.version>7.11.0</testng.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Pin every Selenium module to the mobile-runtime pair; ban drift from Appium transitives. -->
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-bom</artifactId>
                <version>${selenium.mobile.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>mobile-contracts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>${appium.java.client.version}</version>
        </dependency>
        <!-- Explicit Selenium pin (also via BOM); version ranges / LATEST banned by enforcer. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.mobile.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>mobile-runner-banned-dependencies</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- No portal/JPA on the worker classpath -->
                                        <exclude>org.springframework.boot:spring-boot-starter-data-jpa</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-jdbc</exclude>
                                        <exclude>org.hibernate*:*</exclude>
                                        <exclude>com.h2database:*</exclude>
                                        <exclude>org.example:keel-portal</exclude>
                                    </excludes>
                                    <message>mobile-runner: no portal/JPA (architecture §1).</message>
                                </bannedDependencies>
                                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                                <!-- Pins are explicit properties (appium.java.client.version / selenium.mobile.version);
                                     SNAPSHOT internal modules are intentional for box builds. -->
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
