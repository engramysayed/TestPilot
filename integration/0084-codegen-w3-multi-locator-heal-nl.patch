diff --git a/src/main/java/delivery/codegen/DomDiffAssertSuggestor.java b/src/main/java/delivery/codegen/DomDiffAssertSuggestor.java
new file mode 100644
index 0000000..977296a
--- /dev/null
+++ b/src/main/java/delivery/codegen/DomDiffAssertSuggestor.java
@@ -0,0 +1,138 @@
+package delivery.codegen;
+
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * W3: trimmed DOM-diff ??? assert suggestions for Automate emit.
+ * Suggests only stable kinds already supported by page emit (visible / notVisible /
+ * textContains / ariaRole / ariaLabel / region). Caps suggestions to avoid noisy pages.
+ */
+public final class DomDiffAssertSuggestor {
+    public static final int MAX_SUGGESTIONS = 4;
+
+    private DomDiffAssertSuggestor() {
+    }
+
+    /** One DOM-diff delta the AI / prove layer observed. */
+    public record DiffHint(
+            String change,
+            String strategy,
+            String value,
+            String assertionType,
+            String expected,
+            String rationale
+    ) {
+        public DiffHint {
+            change = change == null ? "" : change.trim().toLowerCase(Locale.ROOT);
+            strategy = strategy == null ? "" : strategy.trim();
+            value = value == null ? "" : value;
+            assertionType = assertionType == null ? "" : assertionType.trim();
+            expected = expected == null ? "" : expected;
+            rationale = rationale == null ? "" : rationale;
+        }
+    }
+
+    public record Suggestion(
+            String assertionType,
+            String strategy,
+            String locatorValue,
+            String expected,
+            String rationale
+    ) {
+        public ProvenStep toStep(String tcId, String pageName) {
+            return new ProvenStep(
+                    tcId == null ? "TC_DOMDIFF" : tcId,
+                    pageName == null || pageName.isBlank() ? "Page" : pageName,
+                    "elementAction",
+                    "assert",
+                    strategy,
+                    locatorValue,
+                    "",
+                    assertionType,
+                    expected,
+                    true,
+                    rationale == null || rationale.isBlank() ? "dom-diff:" + assertionType : rationale,
+                    "");
+        }
+    }
+
+    public static List<Suggestion> suggest(List<DiffHint> hints) {
+        if (hints == null || hints.isEmpty()) {
+            return List.of();
+        }
+        Set<String> seen = new LinkedHashSet<>();
+        List<Suggestion> out = new ArrayList<>();
+        for (DiffHint h : hints) {
+            if (h == null || h.value().isBlank()) {
+                continue;
+            }
+            Suggestion s = map(h);
+            if (s == null) {
+                continue;
+            }
+            String key = s.assertionType().toLowerCase(Locale.ROOT) + '\0'
+                    + s.strategy().toLowerCase(Locale.ROOT) + '\0'
+                    + s.locatorValue() + '\0' + s.expected();
+            if (!seen.add(key)) {
+                continue;
+            }
+            out.add(s);
+            if (out.size() >= MAX_SUGGESTIONS) {
+                break;
+            }
+        }
+        return List.copyOf(out);
+    }
+
+    public static void apply(PageAccumulator pages, String tcId, String pageName, List<DiffHint> hints) {
+        for (Suggestion s : suggest(hints)) {
+            pages.add(s.toStep(tcId, pageName));
+        }
+    }
+
+    static Suggestion map(DiffHint h) {
+        String type = h.assertionType();
+        String expected = h.expected();
+        String change = h.change();
+        if (type.isBlank()) {
+            type = switch (change) {
+                case "removed", "gone", "hidden" -> "notVisible";
+                case "added", "appeared", "shown" -> "visible";
+                case "text", "textchanged", "changed" -> "textContains";
+                case "role", "ariarole" -> "ariaRole";
+                case "label", "arialabel" -> "ariaLabel";
+                case "region", "landmark" -> "region";
+                default -> h.expected().isBlank() ? "visible" : "textContains";
+            };
+        }
+        type = switch (type.toLowerCase(Locale.ROOT)) {
+            case "text" -> "textContains";
+            case "textexact", "exacttext" -> "textEquals";
+            case "role", "hasrole" -> "ariaRole";
+            case "accessiblename", "accname" -> "ariaLabel";
+            case "landmark", "inregion" -> "region";
+            case "hidden", "gone" -> "notVisible";
+            case "shown", "appeared" -> "visible";
+            default -> type;
+        };
+        Set<String> allowed = Set.of(
+                "visible", "notVisible", "textContains", "textEquals",
+                "ariaRole", "ariaLabel", "region", "value");
+        if (!allowed.contains(type)) {
+            return null;
+        }
+        if (("textContains".equals(type) || "textEquals".equals(type) || "value".equals(type)
+                || "ariaRole".equals(type) || "ariaLabel".equals(type) || "region".equals(type))
+                && expected.isBlank()) {
+            return null;
+        }
+        String rationale = h.rationale().isBlank()
+                ? "dom-diff:" + change + "->" + type
+                : h.rationale();
+        return new Suggestion(type, h.strategy(), h.value(), expected, rationale);
+    }
+}
diff --git a/src/main/java/delivery/codegen/HealAcceptPatcher.java b/src/main/java/delivery/codegen/HealAcceptPatcher.java
new file mode 100644
index 0000000..44354b4
--- /dev/null
+++ b/src/main/java/delivery/codegen/HealAcceptPatcher.java
@@ -0,0 +1,194 @@
+package delivery.codegen;
+
+import delivery.heal.HealProposal;
+import delivery.portal.service.HealJavaLocatorPatcher;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+/**
+ * Codegen-side alignment for Phase 2 heal Accept/Reject.
+ * Ensures Accept patches an <em>existing</em> generated page class only (never invents
+ * {@code LoginPage2} / never creates a missing class). Reuses {@link HealJavaLocatorPatcher}
+ * and the Phase 2 proposal store shape ??? does not fork a second proposal store.
+ */
+public final class HealAcceptPatcher {
+    private static final Pattern INVENTED_SUFFIX = Pattern.compile(
+            "^.+(Page)?[_]?2$", Pattern.CASE_INSENSITIVE);
+
+    private HealAcceptPatcher() {
+    }
+
+    public record AlignResult(
+            String pageClass,
+            Path pageFile,
+            boolean ok,
+            String detail
+    ) {
+    }
+
+    /**
+     * Collapse Login aliases onto the emitted page class name and reject invented *2 names.
+     */
+    public static String alignPageClass(String pageClass) {
+        if (pageClass == null || pageClass.isBlank()) {
+            throw new HealJavaLocatorPatcher.MissingPageException("pageClass required");
+        }
+        String raw = pageClass.trim();
+        int dot = raw.lastIndexOf('.');
+        String simple = dot >= 0 ? raw.substring(dot + 1) : raw;
+        if (looksInvented(simple)) {
+            throw new HealJavaLocatorPatcher.BadPatchException(
+                    "Refusing invented page class (no LoginPage2): " + simple);
+        }
+        String stem = simple;
+        if (stem.endsWith("_Page")) {
+            stem = stem.substring(0, stem.length() - "_Page".length());
+        } else if (stem.endsWith("Page") && stem.length() > 4) {
+            stem = stem.substring(0, stem.length() - "Page".length());
+        }
+        ProvenStep probe = new ProvenStep(
+                "TC_HEAL", stem, "elementAction", "click",
+                "id", "x", "", "", "", true, "heal-align");
+        String key = PageAccumulator.pageKey(probe);
+        return CodegenNaming.pageClassName(key);
+    }
+
+    public static boolean looksInvented(String pageClass) {
+        if (pageClass == null || pageClass.isBlank()) {
+            return true;
+        }
+        String simple = pageClass.trim();
+        int dot = simple.lastIndexOf('.');
+        if (dot >= 0) {
+            simple = simple.substring(dot + 1);
+        }
+        String lower = simple.toLowerCase(Locale.ROOT);
+        if (lower.contains("loginpage2") || lower.contains("login_page2") || lower.contains("login_2_page")) {
+            return true;
+        }
+        return INVENTED_SUFFIX.matcher(simple).matches()
+                && lower.contains("login");
+    }
+
+    public static String simpleName(String pageClass) {
+        if (pageClass == null || pageClass.isBlank()) {
+            return "";
+        }
+        String raw = pageClass.trim();
+        int dot = raw.lastIndexOf('.');
+        return dot >= 0 ? raw.substring(dot + 1) : raw;
+    }
+
+    /**
+     * Resolve existing page file under {@code src/main/java/project/pages}; 409-equivalent if missing.
+     */
+    public static AlignResult resolveExisting(Path projectRoot, String pageClass) {
+        String aligned = alignPageClass(pageClass);
+        try {
+            Path file = HealJavaLocatorPatcher.resolveExistingPageFile(projectRoot, aligned);
+            return new AlignResult(aligned, file, true, "ok");
+        } catch (HealJavaLocatorPatcher.MissingPageException ex) {
+            try {
+                Path file = HealJavaLocatorPatcher.resolveExistingPageFile(projectRoot, pageClass);
+                return new AlignResult(simpleName(pageClass), file, true, "ok-raw");
+            } catch (RuntimeException ignored) {
+                return new AlignResult(aligned, null, false,
+                        "409: generated page class not found: " + aligned);
+            }
+        }
+    }
+
+    /**
+     * Accept: patch locator in the named existing page class only.
+     */
+    public static HealJavaLocatorPatcher.PatchOutcome accept(
+            Path projectRoot,
+            HealProposal proposal
+    ) throws IOException {
+        if (proposal == null) {
+            throw new HealJavaLocatorPatcher.BadPatchException("proposal required");
+        }
+        if (looksInvented(proposal.pageClass())) {
+            throw new HealJavaLocatorPatcher.BadPatchException(
+                    "Refusing inventing page class on Accept: " + proposal.pageClass());
+        }
+        AlignResult align = resolveExisting(projectRoot, proposal.pageClass());
+        if (!align.ok()) {
+            throw new HealJavaLocatorPatcher.MissingPageException(align.detail());
+        }
+        Map<String, Object> before = locatorMap(proposal.locatorBefore());
+        Map<String, Object> after = locatorMap(proposal.locatorAfter());
+        return HealJavaLocatorPatcher.applyLocatorPatch(
+                projectRoot, align.pageClass(), before, after);
+    }
+
+    /**
+     * Build a Phase 2 proposal map for AE emit (status=pending). Never rewrites Java.
+     */
+    public static Map<String, Object> proposalShell(
+            String proposalId,
+            String projectId,
+            String jobId,
+            String tcId,
+            int stepIndex,
+            String pageClass,
+            String beforeStrategy,
+            String beforeValue,
+            String afterStrategy,
+            String afterValue,
+            String reason
+    ) {
+        String aligned;
+        try {
+            aligned = alignPageClass(pageClass);
+        } catch (RuntimeException ex) {
+            aligned = pageClass == null ? "" : pageClass;
+        }
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("proposalId", proposalId == null ? "" : proposalId);
+        m.put("projectId", projectId == null ? "" : projectId);
+        m.put("jobId", jobId == null ? "" : jobId);
+        m.put("tcId", tcId == null ? "" : tcId);
+        m.put("stepIndex", stepIndex);
+        m.put("pageClass", aligned);
+        Map<String, Object> before = new LinkedHashMap<>();
+        before.put("strategy", beforeStrategy == null ? "" : beforeStrategy);
+        before.put("value", beforeValue == null ? "" : beforeValue);
+        Map<String, Object> after = new LinkedHashMap<>();
+        after.put("strategy", afterStrategy == null ? "" : afterStrategy);
+        after.put("value", afterValue == null ? "" : afterValue);
+        m.put("locatorBefore", before);
+        m.put("locatorAfter", after);
+        m.put("patchKind", "locator");
+        m.put("tier", "codegen-align");
+        m.put("reason", reason == null ? "" : reason);
+        m.put("status", "pending");
+        m.put("createdAt", java.time.Instant.now().toString());
+        m.put("decidedAt", null);
+        m.put("evidenceRel", null);
+        return m;
+    }
+
+    public static boolean pageClassExists(Path projectRoot, String pageClass) {
+        AlignResult r = resolveExisting(projectRoot, pageClass);
+        return r.ok() && r.pageFile() != null && Files.isRegularFile(r.pageFile());
+    }
+
+    private static Map<String, Object> locatorMap(HealProposal.LocatorRef ref) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        if (ref == null) {
+            m.put("strategy", "");
+            m.put("value", "");
+            return m;
+        }
+        m.put("strategy", ref.strategy());
+        m.put("value", ref.value());
+        return m;
+    }
+}
diff --git a/src/main/java/delivery/codegen/MultiLocatorBag.java b/src/main/java/delivery/codegen/MultiLocatorBag.java
new file mode 100644
index 0000000..4f599af
--- /dev/null
+++ b/src/main/java/delivery/codegen/MultiLocatorBag.java
@@ -0,0 +1,134 @@
+package delivery.codegen;
+
+import delivery.store.PreferredHooksStore;
+
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * W3 multi-locator bag: primary + ordered fallbacks per element.
+ * Honors W1 preferred-hook-first (empty hooks keep proven primary ??? never promote)
+ * and W2 semantic ladder / uniqueness / text-drop rules.
+ */
+public final class MultiLocatorBag {
+    /** Primary + up to {@link LocatorCandidate#MAX_FALLBACKS} - 1 fallbacks. */
+    public static final int MAX_ENTRIES = LocatorCandidate.MAX_FALLBACKS;
+
+    private MultiLocatorBag() {
+    }
+
+    public record Entry(String strategy, String value) {
+        public Entry {
+            strategy = strategy == null ? "" : strategy.trim();
+            value = value == null ? "" : value;
+        }
+
+        public String key() {
+            return strategy.toLowerCase(Locale.ROOT) + '\0' + value;
+        }
+    }
+
+    public record Bag(Entry primary, List<Entry> fallbacks) {
+        public Bag {
+            if (primary == null) {
+                primary = new Entry("", "");
+            }
+            fallbacks = fallbacks == null ? List.of() : List.copyOf(fallbacks);
+        }
+
+        public boolean hasFallbacks() {
+            return !fallbacks.isEmpty();
+        }
+
+        public List<Entry> all() {
+            List<Entry> out = new ArrayList<>(1 + fallbacks.size());
+            out.add(primary);
+            out.addAll(fallbacks);
+            return List.copyOf(out);
+        }
+    }
+
+    /**
+     * Build an ordered bag from a proven locator + candidates.
+     * Empty preferred hooks: proven stays primary; candidates may only appear as fallbacks.
+     * Non-empty hooks: ladder may promote preferred/role/label/testid over proven.
+     */
+    public static Bag build(
+            String strategy,
+            String value,
+            List<LocatorCandidate> candidates,
+            List<String> hooks
+    ) {
+        List<String> activeHooks = hooks == null ? PreferredHooksStore.current() : hooks;
+        if (activeHooks == null) {
+            activeHooks = List.of();
+        }
+        boolean promote = !activeHooks.isEmpty();
+        SemanticLocatorLadder.Pick pick = SemanticLocatorLadder.pick(
+                strategy, value, candidates, activeHooks, promote);
+        Entry primary;
+        List<LocatorCandidate> orderedRest;
+        if (pick.rejected() || pick.strategy() == null || pick.strategy().isBlank()) {
+            primary = new Entry(strategy, value);
+            orderedRest = candidates == null ? List.of() : candidates;
+        } else {
+            primary = new Entry(pick.strategy(), pick.value());
+            orderedRest = new ArrayList<>();
+            if (pick.fallbacks() != null) {
+                orderedRest.addAll(pick.fallbacks());
+            }
+            if (candidates != null) {
+                orderedRest.addAll(candidates);
+            }
+            if (strategy != null && value != null && !value.isBlank()) {
+                orderedRest.add(LocatorCandidate.of(strategy, value));
+            }
+        }
+
+        Set<String> seen = new LinkedHashSet<>();
+        seen.add(primary.key());
+        List<Entry> fallbacks = new ArrayList<>();
+        for (LocatorCandidate c : orderedRest) {
+            if (c == null || c.value() == null || c.value().isBlank()) {
+                continue;
+            }
+            if (SemanticLocatorLadder.isNonUnique(c.strategy(), c.value())) {
+                continue;
+            }
+            EmitStepNormalizer.Loc loc = EmitStepNormalizer.Loc.plain(c.strategy(), c.value());
+            if (EmitStepNormalizer.isTextLocator(loc)) {
+                continue;
+            }
+            Entry e = new Entry(c.strategy(), c.value());
+            if (!seen.add(e.key())) {
+                continue;
+            }
+            fallbacks.add(e);
+            if (fallbacks.size() >= MAX_ENTRIES - 1) {
+                break;
+            }
+        }
+        if (promote && fallbacks.size() > 1) {
+            List<String> hooksFinal = activeHooks;
+            fallbacks.sort((a, b) -> Integer.compare(
+                    SemanticLocatorLadder.rank(b.strategy(), b.value(), hooksFinal),
+                    SemanticLocatorLadder.rank(a.strategy(), a.value(), hooksFinal)));
+        }
+        return new Bag(primary, List.copyOf(fallbacks));
+    }
+
+    public static Bag build(ProvenStep step) {
+        if (step == null) {
+            return new Bag(new Entry("", ""), List.of());
+        }
+        ProvenStep normalized = EmitStepNormalizer.apply(step);
+        return build(
+                normalized.locatorStrategy(),
+                normalized.locatorValue(),
+                normalized.locatorCandidates(),
+                PreferredHooksStore.current());
+    }
+}
