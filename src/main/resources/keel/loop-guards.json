    "bugHunter": {"maxAttempts": 60, "maxWallMs": 900000, "maxModelCalls": 80, "maxCostUnits": 400, "warnRepeatAction": 3, "stopRepeatAction": 5, "warnCycle": 2, "stopCycle": 3, "warnFailureStreak": 3, "stopFailureStreak": 5, "stopNoProgress": 8},
    "precision": {"maxAttempts": 4,  "maxWallMs": 60000,  "maxModelCalls": 4,  "maxCostUnits": 20,  "warnRepeatAction": 2, "stopRepeatAction": 2, "warnCycle": 2, "stopCycle": 2, "warnFailureStreak": 2, "stopFailureStreak": 3, "stopNoProgress": 3}
  }
