{
  "contract": "keel.settle-policy",
  "version": 1,
  "doc": "One table for prove, replay and the generated framework (copy verbatim). Times in ms. See patches/A8/PLAN.md.",
  "defaults": {
    "pollMs": 100,
    "spinnerSelectors": [
      "[aria-busy=true]", "[role=progressbar]", ".spinner", ".loading", ".loader", ".MuiCircularProgress-root",
      ".ant-spin-spinning", "[data-loading=true]", "[data-keel-spinner]"
    ]
  },
  "actions": {
    "click":          {"timeoutMs": 10000, "network": "idle", "networkIdleMs": 500, "domStableMs": 300, "animations": true,  "spinners": true,  "url": "any",      "effect": "required", "effectWaitMs": 2000, "sideEffects": "unknown"},
    "doubleClick":    {"timeoutMs": 10000, "network": "idle", "networkIdleMs": 500, "domStableMs": 300, "animations": true,  "spinners": true,  "url": "any",      "effect": "required", "effectWaitMs": 2000, "sideEffects": "unknown"},
    "rightClick":     {"timeoutMs": 5000,  "network": "none", "networkIdleMs": 0,   "domStableMs": 300, "animations": true,  "spinners": false, "url": "same",     "effect": "required", "effectWaitMs": 2000, "sideEffects": "unknown"},
    "hover":          {"timeoutMs": 3000,  "network": "none", "networkIdleMs": 0,   "domStableMs": 200, "animations": true,  "spinners": false, "url": "same",     "effect": "optional", "effectWaitMs": 1000, "sideEffects": "none"   },
    "type":           {"timeoutMs": 5000,  "network": "idle", "networkIdleMs": 300, "domStableMs": 200, "animations": false, "spinners": true,  "url": "same",     "effect": "required", "effectWaitMs": 2000, "sideEffects": "unknown"},
    "typeSecret":     {"timeoutMs": 5000,  "network": "idle", "networkIdleMs": 300, "domStableMs": 200, "animations": false, "spinners": true,  "url": "same",     "effect": "none",     "effectWaitMs": 0, "sideEffects": "unknown"},
    "clear":          {"timeoutMs": 3000,  "network": "none", "networkIdleMs": 0,   "domStableMs": 200, "animations": false, "spinners": false, "url": "same",     "effect": "required", "effectWaitMs": 1000, "sideEffects": "unknown"},
    "press":          {"timeoutMs": 10000, "network": "idle", "networkIdleMs": 500, "domStableMs": 300, "animations": true,  "spinners": true,  "url": "any",      "effect": "optional", "effectWaitMs": 2000, "sideEffects": "unknown"},
    "select":         {"timeoutMs": 10000, "network": "idle", "networkIdleMs": 500, "domStableMs": 300, "animations": true,  "spinners": true,  "url": "any",      "effect": "required", "effectWaitMs": 2000, "sideEffects": "unknown"},
    "check":          {"timeoutMs": 5000,  "network": "idle", "networkIdleMs": 300, "domStableMs": 200, "animations": true,  "spinners": true,  "url": "same",     "effect": "required", "effectWaitMs": 2000, "sideEffects": "unknown"},
    "submit":         {"timeoutMs": 30000, "network": "idle", "networkIdleMs": 500, "domStableMs": 500, "animations": true,  "spinners": true,  "url": "any",      "effect": "required", "effectWaitMs": 5000, "sideEffects": "mutating"},
    "navigate":       {"timeoutMs": 30000, "network": "idle", "networkIdleMs": 500, "domStableMs": 500, "animations": true,  "spinners": true,  "url": "changed",  "effect": "none",     "effectWaitMs": 0, "sideEffects": "none"   },
    "back":           {"timeoutMs": 30000, "network": "idle", "networkIdleMs": 500, "domStableMs": 500, "animations": true,  "spinners": true,  "url": "changed",  "effect": "required", "effectWaitMs": 2000, "sideEffects": "none"   },
    "reload":         {"timeoutMs": 30000, "network": "idle", "networkIdleMs": 500, "domStableMs": 500, "animations": true,  "spinners": true,  "url": "same",     "effect": "none",     "effectWaitMs": 0, "sideEffects": "none"   },
    "scroll":         {"timeoutMs": 3000,  "network": "idle", "networkIdleMs": 300, "domStableMs": 200, "animations": true,  "spinners": true,  "url": "same",     "effect": "optional", "effectWaitMs": 500, "sideEffects": "none"   },
    "scrollIntoView": {"timeoutMs": 3000,  "network": "none", "networkIdleMs": 0,   "domStableMs": 200, "animations": true,  "spinners": false, "url": "same",     "effect": "none",     "effectWaitMs": 0, "sideEffects": "none"   },
    "drag":           {"timeoutMs": 10000, "network": "idle", "networkIdleMs": 500, "domStableMs": 300, "animations": true,  "spinners": true,  "url": "same",     "effect": "required", "effectWaitMs": 2000, "sideEffects": "unknown"},
    "upload":         {"timeoutMs": 60000, "network": "idle", "networkIdleMs": 1000,"domStableMs": 500, "animations": true,  "spinners": true,  "url": "any",      "effect": "required", "effectWaitMs": 5000, "sideEffects": "mutating"},
    "switchFrame":    {"timeoutMs": 5000,  "network": "none", "networkIdleMs": 0,   "domStableMs": 0,   "animations": false, "spinners": false, "url": "any",      "effect": "none",     "effectWaitMs": 0, "sideEffects": "none"   },
    "switchWindow":   {"timeoutMs": 10000, "network": "idle", "networkIdleMs": 500, "domStableMs": 300, "animations": false, "spinners": true,  "url": "any",      "effect": "none",     "effectWaitMs": 0, "sideEffects": "none"   },
    "wait":           {"timeoutMs": 0,     "network": "none", "networkIdleMs": 0,   "domStableMs": 0,   "animations": false, "spinners": false, "url": "any",      "effect": "none",     "effectWaitMs": 0, "sideEffects": "none"   },
    "assert":         {"timeoutMs": 5000,  "network": "idle", "networkIdleMs": 300, "domStableMs": 300, "animations": true,  "spinners": true,  "url": "any",      "effect": "none",     "effectWaitMs": 0, "sideEffects": "none"   },
    "tap":            {"timeoutMs": 10000, "network": "none", "networkIdleMs": 0  , "domStableMs": 300, "animations": true,  "spinners": true,  "url": "any",      "effect": "required", "effectWaitMs": 2000, "sideEffects": "unknown"},
    "longPress":      {"timeoutMs": 10000, "network": "none", "networkIdleMs": 0  , "domStableMs": 300, "animations": true,  "spinners": true,  "url": "any",      "effect": "required", "effectWaitMs": 2000, "sideEffects": "unknown"}
  }
}
