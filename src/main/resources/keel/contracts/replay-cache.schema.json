{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.dev/contracts/replay-cache.schema.json",
  "title": "Engine ReplayCache file (A3 PLAN section 4), version 1",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "entry"
        ],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "$ref": "ranked-locators-ir.schema.json"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
