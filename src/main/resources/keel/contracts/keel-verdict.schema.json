{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.dev/contracts/keel-verdict.schema.json",
  "title": "One line of test-output/keel-results/verdicts.jsonl (KeelRetryListener)",
  "type": "object",
  "required": [
    "test",
    "verdict",
    "attempt",
    "readOnly"
  ],
  "properties": {
    "test": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "PASSED",
        "FLAKY",
        "FAILED",
        "RETRIED",
        "SKIPPED"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "readOnly": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "FLAKY"
          }
        }
      },
      "then": {
        "properties": {
          "attempt": {
            "minimum": 2
          },
          "readOnly": {
            "const": true
          }
        }
      }
    }
  ]
}
