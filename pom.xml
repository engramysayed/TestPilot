<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- B02 (Phase 0a): multi-module skeleton, no behaviour change.
         keel-portal is still the whole existing app (sources stay in ./src); the other modules are empty
         and only carry the build rules that keep them clean (SPLIT_DESIGN §2, PHASE0A_TASKS.md). -->
    <groupId>org.example</groupId>
    <artifactId>keel-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>keel-contract</module>
        <module>keel-common</module>
        <module>keel-engine</module>
        <module>keel-portal</module>
        <module>mobile-contracts</module>
            <module>mobile-runner</module>
            <module>mobile-codegen</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- `mvn -Dtest=X test` from the root keeps working although only keel-portal has tests. -->
        <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
        <!-- `mvn exec:java -Dexec.mainClass=…` from the root runs only in keel-portal (it sets false). -->
        <exec.skip>true</exec.skip>
        <!-- Same for `mvn spring-boot:run` (start-portal.bat): only keel-portal runs (it sets false). -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
        <keel.arch.allowlist.portal-selenium>true</keel.arch.allowlist.portal-selenium>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>3.3.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>keel-java-21</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
